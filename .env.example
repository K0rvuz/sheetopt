# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SHEETOPT_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHEETOPT_ENCRYPTION_KEY=REPLACE_WITH_A_REAL_FERNET_KEY
SHEETOPT_LOG_LEVEL=INFO

# Must match the URL used to access the web UI; do not put a path or trailing slash.
SHEETOPT_PUBLIC_BASE_URL=http://localhost:8080
